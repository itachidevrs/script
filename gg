local env = getgenv()


local ALLOWED_USER_ID = 8199319552  
local localPlayer = game:GetService("Players").LocalPlayer
local userId = localPlayer and localPlayer.UserId or 0

if userId ~= ALLOWED_USER_ID then
    -- Não é o usuário autorizado: encerra silenciosamente, sem fazer nada.
    return
end

assert(not env.ABInventoryCleanupRunning, "Limpeza ja esta em andamento")
assert(game.PlaceId == 109928390521457, "Execute no Anime Breaker")
env.ABInventoryCleanupRunning = true

local identity = getthreadidentity()
local report = { player = game.Players.LocalPlayer.Name, started = os.time(), phases = {}, counts = {} }
local function save()
    env.ABInventoryCleanupReport = report
    if type(writefile) == "function" then
        local current = getthreadidentity()
        setthreadidentity(identity)
        pcall(function()
            writefile("anime-breaker-limpeza-resultado.json", game:GetService("HttpService"):JSONEncode(report))
        end)
        setthreadidentity(current)
    end
end

local ok, err = xpcall(function()
    setthreadidentity(2)
    local L = require(game.ReplicatedStorage.Framework.Library)
    local inventory = L:GetService("InventoryService")
    local equip = L:GetService("EquipService")
    local systems = inventory:GetSystems()
    local categories = { "Pet", "Accessory", "Weapon", "Jewel" }
    local gachaConfig = L:GetData("GachaConfig")
    local function petSpins()
        local keys = {}
        for key, spin in pairs(L.PlayerData.SpinManager or {}) do
            local config = gachaConfig[spin.Id]
            if spin.Id == "Pet" or (config and config.System == "Pet") then
                table.insert(keys, key)
            end
        end
        return keys
    end
    local targets = {}
    local function list(category)
        return assert(L.PlayerData[systems[category].List], "Inventario indisponivel: " .. category)
    end
    local function waitFor(predicate, label)
        local deadline = os.clock() + 12
        repeat
            if predicate() then return end
            task.wait(0.15)
        until os.clock() >= deadline
        error("Sem confirmacao do servidor: " .. label)
    end
    local function fire(action, category, arg)
        L.Remote:Fire("InventorySystem", action, category, arg)
        task.wait(1)
    end
    local function phase(name)
        if name ~= "stop_pet_spin" then
            assert(#petSpins() == 0, "Giro de pets reiniciado; limpeza interrompida")
        end
        table.insert(report.phases, name)
        save()
    end

    phase("stop_pet_spin")
    report.stoppedPetSpins = {}
    for _, key in ipairs(petSpins()) do
        L.Remote:Fire("SpinManagerSystem", "Remove", key)
        table.insert(report.stoppedPetSpins, key)
        task.wait(1)
    end
    local stoppedSince
    waitFor(function()
        if #petSpins() > 0 then
            stoppedSince = nil
            return false
        end
        stoppedSince = stoppedSince or os.clock()
        return os.clock() - stoppedSince >= 2
    end, "parar giro de pets")
    save()

    -- A lista inicial limita a limpeza; novos drops nao entram nesta execucao.
    for _, category in ipairs(categories) do
        targets[category] = {}
        for uid, item in pairs(list(category)) do
            assert(type(item) == "table", "Formato de item inesperado")
            table.insert(targets[category], uid)
        end
        report.counts[category] = { before = #targets[category], deleted = 0 }
    end
    phase("unlock")
    for _, category in ipairs(categories) do
        for _, uid in ipairs(targets[category]) do
            local item = list(category)[uid]
            if item and item.Locked then
                -- Lock alterna o estado; nunca reenviar sem confirmar a atualizacao.
                fire("Lock", category, L:Encode({ uid }))
                waitFor(function()
                    local current = list(category)[uid]
                    return not current or not current.Locked
                end, "unlock " .. category .. " " .. uid)
            end
        end
    end

    phase("unequip")
    for _, category in ipairs(categories) do
        if equip:GetModes(category) then
            fire("UnequipAll", category)
        end
        for _, uid in ipairs(targets[category]) do
            local function equipped()
                local item = list(category)[uid]
                return item and (item.Equipped or equip:IsEquipped(L.PlayerData, category, uid))
            end
            if not equip:GetModes(category) and equipped() then
                fire("Equip", category, uid)
            end
            waitFor(function() return not equipped() end, "unequip " .. category .. " " .. uid)
            if inventory:IsCosmetic(L.PlayerData, category, uid) then
                fire("EquipCosmetic", category, uid)
                waitFor(function()
                    return not inventory:IsCosmetic(L.PlayerData, category, uid)
                end, "cosmetic " .. category .. " " .. uid)
            end
        end
    end

    -- Valida todas as categorias antes de iniciar a exclusao.
    for _, category in ipairs(categories) do
        for _, uid in ipairs(targets[category]) do
            local item = list(category)[uid]
            if item then
                assert(not item.Locked and not item.Equipped and not item.DontChange,
                    "Item bloqueado para exclusao: " .. category .. " " .. uid)
                assert(not equip:IsEquipped(L.PlayerData, category, uid)
                    and not inventory:IsCosmetic(L.PlayerData, category, uid), "Item ainda equipado: " .. uid)
                assert(not systems[category].IsBusy or not systems[category].IsBusy(L.PlayerData, uid),
                    "Item em uso: " .. uid)
            end
        end
    end
    phase("delete")
    for _, category in ipairs(categories) do
        for start = 1, #targets[category], 25 do
            local batch = {}
            for index = start, math.min(start + 24, #targets[category]) do
                local uid = targets[category][index]
                if list(category)[uid] then table.insert(batch, uid) end
            end
            if #batch > 0 then
                fire("Delete", category, L:Encode(batch))
                waitFor(function()
                    for _, uid in ipairs(batch) do
                        if list(category)[uid] then return false end
                    end
                    return true
                end, "delete " .. category)
                report.counts[category].deleted = report.counts[category].deleted + #batch
                save()
            end
        end
        local remaining = 0
        for _ in pairs(list(category)) do remaining = remaining + 1 end
        report.counts[category].remaining = remaining
    end
    phase("complete")
end, function(message) return tostring(message) end)

setthreadidentity(identity)
report.ok = ok
report.error = not ok and err or nil
report.finished = os.time()
save()
env.ABInventoryCleanupRunning = nil
if not ok then error(err, 0) end
print("Anime Breaker: limpeza concluida. Relatorio: anime-breaker-limpeza-resultado.json")
