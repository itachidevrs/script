local function getcustomasset(path)
    if type(path)~="string" then return "" end
    if path:match("^rbxasset") then return path end
    if not originalAsset then return "" end
    if isfile then local ok,exists=pcall(isfile,path);if not ok or not exists then return "" end end
    local ok,value=pcall(originalAsset,path)
    return ok and type(value)=="string" and value or ""
end
