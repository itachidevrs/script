local UI_URL="https://raw.githubusercontent.com/itachidevrs/script/main/itachilibrary"
  local function loadInterface()
      local cache="itachi-ui-cache-v1.lua"
      local failures={}
      local function validate(source,label)
          assert(type(source)=="string" and #source>0,label..": empty library")
          local chunk,err=loadstring(source,"Itachi UI: "..label)
          assert(chunk,err)
          local library=chunk()
          assert(type(library)=="table" and library.APIVersion==1 and type(library.CreateWindow)=="function" and type(library.GetLogo)=="function",label..": incompatible library")
          return library
      end
      for _,path in ipairs({cache,"itachi-ui.lua"}) do
          if readfile and isfile and isfile(path) then
              local success,result=pcall(function()return validate(readfile(path),path)end)
              if success then return result end
          end
      end
      local ok,library=pcall(function()
          local req=request or http_request
          local source
          if req then
              local response=req({Url=UI_URL,Method="GET",Timeout=12})
              assert(response.StatusCode==200,"HTTP "..tostring(response.StatusCode))
              source=response.Body
          else source=game:HttpGet(UI_URL) end
          local result=validate(source,"GitHub")
          if writefile then pcall(writefile,cache,source) end
          return result
      end)
      if ok then return library end
      table.insert(failures,tostring(library))
      for _,path in ipairs({"itachi-ui.lua",cache}) do
          if readfile and isfile and isfile(path) then
              local success,result=pcall(function()return validate(readfile(path),path)end)
              if success then warn("[Itachi Hub] Using local library: "..path);return result end
              table.insert(failures,tostring(result))
          end
      end
      error("Could not load Itachi UI. Publish itachi-ui.lua as itachilibrary or place the file in the executor workspace.\n"..table.concat(failures,"\n"))
  end

